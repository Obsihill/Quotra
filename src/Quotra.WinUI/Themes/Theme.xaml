<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Solid theme colors are the fallback when Acrylic is disabled or unavailable. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="WidgetBorderBrush" Color="#FF454545" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC5C5C5" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FFA6A6A6" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#FF393939" />
            <SolidColorBrush x:Key="BadgeBrush" Color="#FF333333" />
            <SolidColorBrush x:Key="BadgeBorderBrush" Color="#FF424242" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FF383838" />
            <SolidColorBrush x:Key="TrackBrush" Color="#FF383838" />
            <SolidColorBrush x:Key="GaugeOutlineBrush" Color="#FF777777" />
            <SolidColorBrush x:Key="GaugeTextOnFillBrush" Color="#FF102018" />
            <SolidColorBrush x:Key="GaugeContrastFillBrush" Color="#FF6CCB9A" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="WidgetBorderBrush" Color="#FFD1D1D1" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF505050" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF646464" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#FFE5E5E5" />
            <SolidColorBrush x:Key="BadgeBrush" Color="#FFFAFAFA" />
            <SolidColorBrush x:Key="BadgeBorderBrush" Color="#FFE0E0E0" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FFDDDDDD" />
            <SolidColorBrush x:Key="TrackBrush" Color="#FFE5E5E5" />
            <SolidColorBrush x:Key="GaugeOutlineBrush" Color="#FF8A8A8A" />
            <SolidColorBrush x:Key="GaugeTextOnFillBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="GaugeContrastFillBrush" Color="#FF16834D" />
        </ResourceDictionary>

        <!-- Respect the user's Windows contrast colors instead of hardcoding black. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WidgetBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardHoverBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BadgeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GaugeOutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GaugeTextOnFillBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="GaugeContrastFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Windows' Korean UI family also covers unpackaged apps without language resources. -->
    <FontFamily x:Key="WidgetFontFamily">Malgun Gothic</FontFamily>

    <Style x:Key="RowTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WidgetFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WidgetFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProviderDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="4,12" />
        <Setter Property="Background" Value="{ThemeResource DividerBrush}" />
    </Style>
</ResourceDictionary>
