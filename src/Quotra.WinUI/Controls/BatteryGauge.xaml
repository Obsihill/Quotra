<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quotra.WinUI.Controls.BatteryGauge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Matte battery: neutral outline, inset fill and a quiet terminal. -->
    <Grid x:Name="Root" Height="24" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Body" Background="{ThemeResource TrackBrush}"
                BorderBrush="{ThemeResource GaugeOutlineBrush}" BorderThickness="1" CornerRadius="5">
            <Grid x:Name="BodyInner" Padding="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FillColumn" Width="1*" />
                    <ColumnDefinition x:Name="RestColumn" Width="0*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Fill" CornerRadius="2"
                        Background="{ThemeResource GaugeContrastFillBrush}">
                    <!-- Hide the custom color in a Windows contrast theme. -->
                    <Border x:Name="SeverityFill" CornerRadius="2" />
                </Border>
                <TextBlock x:Name="GaugeTextOnFill" Grid.ColumnSpan="2" Margin="5,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource WidgetFontFamily}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource GaugeTextOnFillBrush}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="GaugeTextOnTrack" Grid.ColumnSpan="2" Margin="5,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource WidgetFontFamily}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </Border>
        <Border x:Name="Nub" Grid.Column="1" Width="3" Height="8" Margin="2,0,0,0"
                CornerRadius="0,2,2,0" Background="{ThemeResource GaugeOutlineBrush}" />
    </Grid>
</UserControl>
