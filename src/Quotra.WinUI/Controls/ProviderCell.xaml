<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quotra.WinUI.Controls.ProviderCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quotra.WinUI.Controls"
    UseLayoutRounding="True">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Rest" />
                <VisualState x:Name="Hovered">
                    <VisualState.Setters>
                        <Setter Target="Surface.Background" Value="{ThemeResource CardHoverBrush}" />
                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource CardHoverBorderBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="Surface" Padding="10,7" CornerRadius="4"
                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
            <Border.BackgroundTransition>
                <BrushTransition Duration="0:0:0.12" />
            </Border.BackgroundTransition>
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource BadgeBrush}" CornerRadius="4"
                            BorderBrush="{ThemeResource BadgeBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Border x:Name="BrandTint" Opacity="0.12" CornerRadius="3" />
                            <TextBlock x:Name="Monogram" FontFamily="{StaticResource WidgetFontFamily}"
                                       FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="NameLabel" Grid.Column="1" Style="{StaticResource RowTitleTextStyle}" />
                    <TextBlock x:Name="WindowLabel" Grid.Column="2" MaxWidth="64"
                               Style="{StaticResource RowMetaTextStyle}" />
                </Grid>
                <controls:BatteryGauge x:Name="Gauge" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
